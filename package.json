{
  "name": "@unabandoned/testing-library-preact",
  "version": "3.2.4",
  "description": "Simple and complete Preact DOM testing utilities that encourage good testing practices.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./dist/esm/index.mjs",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    },
    "./pure": {
      "types": "./pure.d.ts",
      "browser": "./dist/esm/pure.mjs",
      "import": "./dist/esm/pure.mjs",
      "require": "./dist/cjs/pure.js"
    },
    "./dont-cleanup-after-each": "./dont-cleanup-after-each.js",
    "./dont-cleanup-after-each.js": "./dont-cleanup-after-each.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "Rahim Alwer <rahim_alwer@hotmail.com>",
  "homepage": "https://github.com/unabandoned/preact-testing-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/preact-testing-library.git"
  },
  "bugs": {
    "url": "https://github.com/unabandoned/preact-testing-library/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "testing",
    "preact",
    "ui",
    "dom",
    "jsdom",
    "unit",
    "integration",
    "functional",
    "end-to-end",
    "e2e"
  ],
  "files": [
    "dist",
    "dont-cleanup-after-each.js",
    "pure.js",
    "pure.d.ts",
    "types"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node scripts/build.mjs",
    "test": "npm run build && vitest run && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@testing-library/dom": "^10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@testing-library/jest-dom": "7.0.1",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "preact": "10.29.8",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "preact": ">=10 || ^10.0.0-alpha.0 || ^10.0.0-beta.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
